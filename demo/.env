# Creative Studio demo: the env file `npm run demo` points STUDIO_ENV_FILE at. It holds NO keys on purpose: the demo
# never calls Jev, Meta, GHL, YouTube, Higgsfield, Codex or claude. scripts/demo.ts sets every other value itself (the
# data folder, the media folder, the port and every outside path), so nothing here or in your own install is shared.
STUDIO_DRIVE_MODE=folder
